{
  "name": "@adobe/aem-translation-connector-sdk",
  "version": "0.0.0",
  "description": "Contract, fake host, and conformance suite for AEM translation connectors",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./testing": "./src/testing/index.js",
    "./build": "./src/build/index.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "test": "c8 mocha",
    "lint": "eslint .",
    "semantic-release": "semantic-release",
    "semantic-release-dry": "semantic-release --dry-run --branches $CI_BRANCH"
  },
  "mocha": {
    "reporter": "mocha-multi-reporters",
    "reporter-options": "configFile=.mocha-multi.json",
    "require": [
      "mocha-suppress-logs"
    ],
    "spec": "test/**/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adobe/aem-translation-connectors.git",
    "directory": "packages/sdk"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-translation-connectors/issues"
  },
  "homepage": "https://github.com/adobe/aem-translation-connectors/tree/main/packages/sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "ajv": "8.20.0",
    "esbuild": "0.28.2"
  },
  "bin": {
    "aem-connector-build": "bin/build-connector.js"
  },
  "sideEffects": false,
  "main": "src/index.js"
}
