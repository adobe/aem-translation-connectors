{
  "name": "@adobe/aem-translation-connectors",
  "version": "0.0.0",
  "private": true,
  "description": "Translation connectors for AEM",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "prepare": "husky",
    "test": "npm test --workspaces --if-present",
    "semantic-release": "npm run semantic-release --workspaces --if-present",
    "semantic-release-dry": "npm run semantic-release-dry --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check-release": "aem-connector-check-release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adobe/aem-translation-connectors.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-translation-connectors/issues"
  },
  "homepage": "https://github.com/adobe/aem-translation-connectors#readme",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@adobe/eslint-config-helix": "3.0.35",
    "@eslint/config-helpers": "0.7.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/npm": "13.2.0",
    "c8": "12.0.0",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "mocha": "12.0.3",
    "mocha-multi-reporters": "1.5.2",
    "mocha-suppress-logs": "0.6.0",
    "semantic-release": "25.0.9",
    "semantic-release-monorepo": "8.0.2"
  },
  "lint-staged": {
    "*.js": "eslint"
  },
  "workspaces": [
    "packages/*",
    "connectors/*"
  ]
}
